{
  "info": {
    "_postman_id": "f5127b14-8cdd-4abb-bf9a-4ffb41fbc6c6",
    "name": "WebGIS UMKM Tembakau Pamekasan API Collection",
    "description": "Koleksi Automated API Testing untuk pengujian endpoint publik, autentikasi, analisis spasial GeoJSON, dan CRUD manajerial WebGIS Tembakau Kabupaten Pamekasan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "xsrfToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Public Endpoints",
      "item": [
        {
          "name": "Get Public Dashboard (HTML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('HTML contains brand identity', function () {",
                  "    pm.expect(pm.response.text()).to.include('WebGIS Tembakau');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Public GeoJSON All UMKM",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/geojson/umkms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geojson", "umkms"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is valid GeoJSON FeatureCollection', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.type).to.eql('FeatureCollection');",
                  "    pm.expect(json.features).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Filtered GeoJSON by District (Tlanakan)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/geojson/umkms?district_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geojson", "umkms"],
              "query": [
                {
                  "key": "district_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Filtered features contain valid district properties', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.features.length > 0) {",
                  "        pm.expect(json.features[0].properties.district_id).to.eql(1);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Districts Boundaries GeoJSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/geojson/districts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geojson", "districts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Metadata region is Kabupaten Pamekasan', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.metadata.region).to.eql('Kabupaten Pamekasan');",
                  "    pm.expect(json.features.length).to.be.at.least(13);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Single UMKM Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/umkms/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "umkms", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('UMKM response has capacity and district', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('production_capacity');",
                  "    pm.expect(json).to.have.property('latitude');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Security & Authorization",
      "item": [
        {
          "name": "Access Admin Panel Without Auth (Expected 302 Redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": ["{{baseUrl}}"],
              "path": ["admin"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 302 Redirect to Login', function () {",
                  "    pm.response.to.have.status(302);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
